<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#1A0505">
    
    <!-- Top Navigation -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="#2D1515" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:id="@+id/tvProjectName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Maha Editor" android:textColor="#D4AF37" android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/btnExport" android:layout_width="wrap_content" android:layout_height="35dp" android:backgroundTint="#D4AF37" android:textColor="#1A0505" android:text="EXPORT" android:textSize="12sp" />
    </LinearLayout>
    
    <!-- The Full Engine View -->
    <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>
