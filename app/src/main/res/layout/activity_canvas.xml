<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0505">

    <!-- Top Action Toolbar -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#2D1515"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Maha Canvas Editor"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Save"
            android:backgroundTint="#D4AF37"
            android:textColor="#1A0505"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Export"
            android:backgroundTint="#442222"
            android:textColor="#D4AF37"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The WYSIWYG Web Canvas -->
    <WebView
        android:id="@+id/webViewCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Element Addition Toolbar -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#2D1515"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnAddHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Header"
            android:backgroundTint="#D4AF37"
            android:textColor="#1A0505"
            android:layout_marginHorizontal="6dp" />

        <Button
            android:id="@+id/btnAddText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Text"
            android:backgroundTint="#D4AF37"
            android:textColor="#1A0505"
            android:layout_marginHorizontal="6dp" />

        <Button
            android:id="@+id/btnAddButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Button"
            android:backgroundTint="#D4AF37"
            android:textColor="#1A0505"
            android:layout_marginHorizontal="6dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
